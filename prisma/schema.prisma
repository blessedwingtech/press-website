datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("reader")    // "admin", "journalist", "reader"
  status    String    @default("active")    // "active", "banned"
  articles  Article[]
  createdAt DateTime  @default(now())
}

model Menu {
  id       String    @id @default(uuid())
  nom      String
  slug     String    @unique
  order    Int       @default(0)
  submenus SubMenu[]
  articles Article[]
}

model SubMenu {
  id       String    @id @default(uuid())
  nom      String
  slug     String    @unique
  order    Int       @default(0)
  menuId   String
  menu     Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  articles Article[]

  // Relation inverse pour le cross-publishing dans Actualités
  actualitesArticles Article[] @relation("ActualitesSubMenu")
}

model Article {
  id              String   @id @default(uuid())
  titre           String
  slug            String   @unique
  contenu         String   // Stores HTML rich text
  imagePrincipale String   // Main image URL or local upload path
  datePublication DateTime @default(now())
  
  auteurId        String
  auteur          User     @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  
  menuId          String
  menu            Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  
  submenuId       String?
  submenu         SubMenu? @relation(fields: [submenuId], references: [id], onDelete: SetNull)

  // Cross-publishing sous le menu "Actualités"
  alsoInActualites    Boolean  @default(false)
  actualitesSubmenuId String?
  actualitesSubmenu   SubMenu? @relation("ActualitesSubMenu", fields: [actualitesSubmenuId], references: [id], onDelete: SetNull)

  // Flag pour identifier les données démo du seed
  isDemo          Boolean  @default(false)

  @@index([menuId])
  @@index([submenuId])
  @@index([datePublication])
  @@index([slug])
  @@index([actualitesSubmenuId])
}

model Ad {
  id       String  @id @default(uuid())
  titre    String
  imageUrl String  // Image URL or local path
  lien     String  // Click URL
  position String  // "header", "sidebar", "footer", "left-sidebar", etc.
  active   Boolean @default(true)
  isDemo   Boolean @default(false)
}

model SystemSetting {
  key   String @id
  value String
}

model AdSetting {
  position String @id // ex: "header", "sidebar", "footer", "left-sidebar"
  limit    Int    @default(5)
  interval Int    @default(10) // rotation en secondes
}

