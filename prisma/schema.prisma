datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String   @id @default(uuid())
  name             String
  email            String   @unique
  password         String
  role             String   @default("reader")
  status           String   @default("active")
  resetToken       String?  @unique
  resetTokenExpiry DateTime?
  profilePhoto     String?
  createdAt        DateTime @default(now())
  articles         Article[]
  galleryImages GalleryImage[]
  ads           Ad[]           @relation("UserAds")
}

model Menu {
  id       String    @id @default(uuid())
  nom      String
  slug     String    @unique
  order    Int       @default(0)
  submenus SubMenu[]
  articles Article[]
}

model SubMenu {
  id       String    @id @default(uuid())
  nom      String
  slug     String    @unique
  order    Int       @default(0)
  menuId   String
  menu     Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  articles Article[]

  actualitesArticles Article[] @relation("ActualitesSubMenu")
}

model Article {
  id                   String   @id @default(uuid())
  titre                String
  slug                 String   @unique
  contenu              String
  imagePrincipale      String
  datePublication      DateTime @default(now())
  auteurId             String
  auteur               User     @relation(fields: [auteurId], references: [id], onDelete: Cascade)
  menuId               String
  menu                 Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  submenuId            String?
  submenu              SubMenu? @relation(fields: [submenuId], references: [id], onDelete: SetNull)
  alsoInActualites     Boolean  @default(false)
  actualitesSubmenuId  String?
  actualitesSubmenu    SubMenu? @relation("ActualitesSubMenu", fields: [actualitesSubmenuId], references: [id], onDelete: SetNull)
  isDemo               Boolean  @default(false)
  views                Int      @default(0)
  ratings              Rating[]

  @@index([menuId])
  @@index([submenuId])
  @@index([datePublication])
  @@index([slug])
  @@index([actualitesSubmenuId])
}

model Ad {
  id          String  @id @default(uuid())
  titre       String
  imageUrl    String
  lien        String
  position    String
  active      Boolean @default(true)
  isDemo      Boolean @default(false)
  impressions Int     @default(0)
  clicks      Int     @default(0)
  ownerId     String?
  owner       User?   @relation("UserAds", fields: [ownerId], references: [id], onDelete: SetNull)
}

model SystemSetting {
  key   String @id
  value String
}

model AdSetting {
  position String @id
  limit    Int    @default(5)
  interval Int    @default(10)
}

model GalleryImage {
  id          String   @id @default(uuid())
  url         String   // URL publique R2
  title       String?  // Titre optionnel
  description String?  // Description
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String   // qui a uploadé (relation avec User)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Rating {
  id                String   @id @default(uuid())
  articleId         String
  article           Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  stars             Int      // 0 à 5
  sessionIdentifier String   // Cookie UUID ou IP hashé pour la prévention des doublons
  createdAt         DateTime @default(now())

  @@unique([articleId, sessionIdentifier])
  @@index([articleId])
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String   // Ex: "RATING_ADD", "ARTICLE_VIEW", "USER_CREATE", "ARTICLE_SHARE"
  details   String
  userId    String?
  ipAddress String?
  createdAt DateTime @default(now())
}

model AccountRequest {
  id                String   @id @default(uuid())
  name              String
  username          String   @unique
  email             String   @unique
  role              String   @default("reader")
  profilePhoto      String?
  status            String   @default("PENDING") // PENDING, CONFIRMED_EMAIL, APPROVED, REJECTED
  confirmationToken String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

